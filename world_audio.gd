extends Node

# Music and ambience in the game world (generated by tools/make_audio.gd). The calm
# nature music is the one continuous BackgroundMusic player shared with the lobby.
# Street ambience by day crossfades to crickets at night; both are quieter indoors;
# rain plays on rainy days (business.is_raining()).
const AUDIO := "res://assets/audio/generated/%s.wav"
const AMBIENCE_OUTDOOR_DB := -13.0
const AMBIENCE_INDOOR_DB := -27.0
const RAIN_OUTDOOR_DB := -10.0
const RAIN_INDOOR_DB := -22.0

var music: AudioStreamPlayer
var ambience: AudioStreamPlayer
var night_ambience: AudioStreamPlayer
var rain: AudioStreamPlayer
@onready var world = get_tree().current_scene
@onready var business = world.get_node("Shop/ShopArea").business
@onready var player = world.get_node_or_null("Player")

func _ready() -> void:
	name = "WorldAudio"
	music = preload("res://background_music.gd").ensure(get_tree())
	ambience = _player("Ambience", "ambience_street", AMBIENCE_OUTDOOR_DB)
	night_ambience = _player("NightAmbience", "ambience_night", -80.0)
	rain = _player("Rain", "rain", -80.0)
	_build_rain()
	_update(0.0, true)

var rain_particles: CPUParticles3D

## Falling rain streaks that follow the camera (only visible on rainy days).
func _build_rain() -> void:
	rain_particles = CPUParticles3D.new()
	rain_particles.name = "RainParticles"
	var streak := QuadMesh.new()
	streak.size = Vector2(0.02, 0.55)
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.albedo_color = Color(0.75, 0.82, 0.9, 0.45)
	material.billboard_mode = BaseMaterial3D.BILLBOARD_FIXED_Y
	streak.material = material
	rain_particles.mesh = streak
	var settings := ConfigFile.new()
	var low: bool = settings.load(world.get_meta("session_settings_path", "user://settings.cfg")) == OK and int(settings.get_value("game", "graphics", 0)) == 0
	rain_particles.amount = 350 if low else 900
	rain_particles.lifetime = 0.9
	rain_particles.emission_shape = CPUParticles3D.EMISSION_SHAPE_BOX
	rain_particles.emission_box_extents = Vector3(16, 0.5, 16)
	rain_particles.direction = Vector3(0.05, -1, 0)
	rain_particles.spread = 3.0
	rain_particles.initial_velocity_min = 14.0
	rain_particles.initial_velocity_max = 17.0
	rain_particles.gravity = Vector3(0, -9.8, 0)
	rain_particles.local_coords = false
	rain_particles.emitting = false
	world.add_child.call_deferred(rain_particles)

func _player(node_name: String, track: String, volume: float) -> AudioStreamPlayer:
	var node := AudioStreamPlayer.new()
	node.name = node_name
	node.stream = load(AUDIO % track)
	node.volume_db = volume
	add_child(node)
	if DisplayServer.get_name() != "headless": node.play()
	return node

func is_night() -> bool:
	return business.minutes_of_day < 360 or business.minutes_of_day >= 1200

func _process(delta: float) -> void:
	_update(delta)

func _update(delta: float, immediate := false) -> void:
	var indoors: bool = is_instance_valid(player) and (player.indoors or player.shop_indoors or player.warehouse_indoors)
	var speed := 1.0 if immediate else minf(delta * 2.0, 1.0)
	var level := AMBIENCE_INDOOR_DB if indoors else AMBIENCE_OUTDOOR_DB
	ambience.volume_db = lerpf(ambience.volume_db, -80.0 if is_night() else level, speed * 0.5)
	night_ambience.volume_db = lerpf(night_ambience.volume_db, level if is_night() else -80.0, speed * 0.5)
	var raining: bool = business.has_method("is_raining") and business.is_raining()
	var target := -80.0 if not raining else (RAIN_INDOOR_DB if indoors else RAIN_OUTDOOR_DB)
	rain.volume_db = lerpf(rain.volume_db, target, speed)
	if is_instance_valid(rain_particles) and rain_particles.is_inside_tree():
		var camera := get_viewport().get_camera_3d()
		rain_particles.emitting = raining and not indoors
		if camera != null: rain_particles.global_position = camera.global_position + Vector3(0, 9, 0)
